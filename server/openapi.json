            "description": "נתונים לא תקינים",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "נתונים לא תקינים"
                }
              }
            }
          },
          "401": {
            "description": "חסר Token או שאינו תקין",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
